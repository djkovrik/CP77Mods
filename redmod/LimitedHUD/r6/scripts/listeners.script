@module "LimitedHUD"

abstract class LimitedHUDSubscriber extends IScriptable {
  public var owner: weak<LimitedHUDContext>;
  public virtual function Refresh() {}
}

class LimitedHUDSubscribers extends IScriptable {
  private var entries: array<weak<LimitedHUDSubscriber>>;
  private var sweepAt: Int32;

  public function Subscribe(entry: LimitedHUDSubscriber) {
    // Reclaim expired widgets even when no visibility condition changes for a long time.
    if (this.entries.Size() >= this.sweepAt) {
      let i: Int32 = this.entries.Size() - 1;
      while (i >= 0) {
        if (!this.entries[i]) { this.entries.EraseFast(i); }
        i -= 1;
      }
      this.sweepAt = 32 + this.entries.Size() * 2;
    }
    this.entries.PushBack(entry);
  }

  public function Refresh() {
    let i: Int32 = this.entries.Size() - 1;
    while (i >= 0) {
      let entry: LimitedHUDSubscriber = this.entries[i];
      if (entry) { entry.Refresh(); }
      else { this.entries.EraseFast(i); }
      i -= 1;
    }
  }
}

class LimitedMinimapContainerControllerSubscriber extends LimitedHUDSubscriber {
  public var target: weak<MinimapContainerController>;
  public override function Refresh() {
    if (this.target) { this.target.RefreshLimitedSubscriber(); }
  }
}

@addField(MinimapContainerController)
var limitedSubscription: LimitedMinimapContainerControllerSubscriber;

@addMethod(MinimapContainerController)
function BindLimitedSubscriber(state: LimitedHUDContext) {
  if (!state || (this.limitedSubscription && this.limitedSubscription.owner == state)) { return; }
  this.limitedSubscription = new LimitedMinimapContainerControllerSubscriber;
  this.limitedSubscription.target = this;
  this.limitedSubscription.owner = state;
  state.panels.Subscribe(this.limitedSubscription);
}

