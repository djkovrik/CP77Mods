class LineDirectionData extends IScriptable {
  public let path: CName;
  public let line: ModNCartLine;
  public let stations: array<Int32>;
  public let moveForward: Bool;

  public static function Create(path: CName, line: ModNCartLine, stations: array<Int32>, forward: Bool) -> LineDirectionData {
    let instance: LineDirectionData = new LineDirectionData;
    instance.path = path;
    instance.line = line;
    instance.stations = stations;
    instance.moveForward = forward;
    return instance;
  }
}

class RouteSegment extends IScriptable {
  public let activeStationId: Int32;
  public let nextStationId: Int32;
  public let line: ModNCartLine;

  public static function Create(activeStationId: Int32, nextStationId: Int32, line: ModNCartLine) -> RouteSegment {
    let instance: RouteSegment = new RouteSegment;
    instance.activeStationId = activeStationId;
    instance.nextStationId = nextStationId;
    instance.line = line;
    return instance;
  }
}

class ShowPocketGuideWidgetEvent extends Event {}
class HidePocketGuideWidgetEvent extends Event {}

class InjectPocketGuideToHudEvent extends Event {}
class RemovePocketGuideFromHudEvent extends Event {}

enum RoutePointType {
  NONE = 0,
  STATION = 1,
  LINE_SWITCH = 2,
  MISSED_STATION = 3,
}

enum RoutePointStatus {
  NOT_VISITED = 0,
  ACTIVE = 1,
  VISITED = 2,
}

enum ModNCartLine {
  NONE = 0,
  A_RED = 1,
  B_YELLOW = 2,
  C_CYAN = 3,
  D_GREEN = 4,
  E_ORANGE = 5,
}

enum MpgControlMode {
  NAVIGATE = 0,
  CANCEL = 1,
  CONFIRM = 2,
  STOP = 3,
}

