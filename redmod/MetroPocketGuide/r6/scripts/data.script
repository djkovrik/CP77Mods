@module "MetroPocketGuide"

class MetroNode extends IScriptable {
  public let uniqueIndex: Int32;
  public let stationId: Int32;
  public let line: ModNCartLine;

  public static function Create(index: Int32, id: Int32, line: ModNCartLine) -> MetroNode {
    let instance: MetroNode = new MetroNode;
    instance.uniqueIndex = index;
    instance.stationId = id;
    instance.line = line;
    return instance;
  }

  public final function Key() -> Uint64 {
    return Cast<Uint64>(this.Index());
  }

  public final function Index() -> Int32 {
    return this.uniqueIndex;
  }

  public final function StationId() -> Int32 {
    return this.stationId;
  }

  public final function Line() -> ModNCartLine {
    return this.line;
  }
}

class MetroGraphNode extends IScriptable {
  public let neighbours: array<Int32>;

  public static function Create(neighbours: array<Int32>) -> MetroGraphNode {
    let instance: MetroGraphNode = new MetroGraphNode;
    instance.neighbours = neighbours;
    return instance;
  }

  public function GetNeighbours() -> array<Int32> {
    return this.neighbours;
  }
}

class MetroNodesQueue extends IScriptable {
  public let internal: array<Int32>;

  public final function Add(item: Int32) -> Void {
    this.internal.PushBack(item);
  }

  public final function PopLeft() -> Int32 {
    if (this.IsEmpty()) {
      return 0;
    }

    let first: Int32 = this.internal[0];
    this.internal.Erase(0);
    return first;
  }

  public final function IsNotEmpty() -> Bool {
    return this.internal.Size() > 0;
  }

  public final function IsEmpty() -> Bool {
    return !this.IsNotEmpty();
  }
}

abstract class RoutePoint extends IScriptable {
  public let index: Int32;
  public let type: RoutePointType;
  public let status: RoutePointStatus;
  public let station: ENcartStations;
  public let stationId: Int32;

  public final function SetIndex(value: Int32) -> Void {
    this.index = value;
  }

  public final function UpdateStatus(value: RoutePointStatus) -> Void {
    this.status = value;
  }

  public final function GetStatus() -> RoutePointStatus {
    return this.status;
  }

  public final function IsStationPoint() -> Bool {
    return (this.type == RoutePointType.STATION);
  }

  public final function IsLineSwitch() -> Bool {
    return (this.type == RoutePointType.LINE_SWITCH);
  }

  public final function AsStationPoint() -> StationPoint {
    if ((this.type == RoutePointType.STATION)) {
      return this as StationPoint;
    }

    return NULL;
  }

  public final function AsLineSwitch() -> LineSwitch {
    if ((this.type == RoutePointType.LINE_SWITCH)) {
      return this as LineSwitch;
    }

    return NULL;
  }
}

class StationPoint extends RoutePoint {
  public let line: ModNCartLine;
  public let startingPoint: Bool;
  public let destinationPoint: Bool;
  public let stationTitle: String;
  public let district: ENcartDistricts;
  public let districtTitle: String;

  public static function Create(stationId: Int32, line: ModNCartLine, start: Bool, destination: Bool) -> StationPoint {
    let station: ENcartStations = MetroDataHelper.GetStationNameById(stationId);
    let stationTitle: String = MetroDataHelper.GetStationTitle(station);
    let district: ENcartDistricts = MetroDataHelper.GetStationDistrict(station);
    let districtTitle: String = MetroDataHelper.GetDistrictTitle(district);
    let instance: StationPoint = new StationPoint;

    instance.type = RoutePointType.STATION;
    instance.stationId = stationId;
    instance.line = line;
    instance.startingPoint = start;
    instance.destinationPoint = destination;
    instance.station = station;
    instance.stationTitle = stationTitle;
    instance.district = district;
    instance.districtTitle = districtTitle;

    return instance;
  }
}

class LineSwitch extends RoutePoint {
  public let from: ModNCartLine;
  public let to: ModNCartLine;
  public let stationTitle: String;

  public static function Create(stationId: Int32, from: ModNCartLine, to: ModNCartLine) -> LineSwitch {
    let station: ENcartStations = MetroDataHelper.GetStationNameById(stationId);
    let stationTitle: String = MetroDataHelper.GetStationTitle(station);
    let instance: LineSwitch = new LineSwitch;
    instance.type = RoutePointType.LINE_SWITCH;
    instance.stationId = stationId;
    instance.station = station;
    instance.stationTitle = stationTitle;
    instance.from = from;
    instance.to = to;
    return instance;
  }
}

