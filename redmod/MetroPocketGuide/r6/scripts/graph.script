@module "MetroPocketGuide"

class MetroNodesGraph extends IScriptable {
  private let graph: inkHashMap;
  private let stations: inkHashMap;
  private let n: Int32 = 44;

  public function Initialize() {
    this.graph = new inkHashMap;
    this.stations = new inkHashMap;

    this.PopulateGraph();
  }

  public final function FindRoute(from: ENcartStations, to: ENcartStations) -> array<RoutePoint> {
    let env: MetroNodesGraph = this;
    let path: array<Int32> = env.FindShortestPath(from, to);
    let prettyPath: array<MetroNode> = env.PrettifyPath(path);
    let route: array<RoutePoint> = env.BuildRouteDetails(prettyPath);
    let cleaned: array<RoutePoint> = env.RemoveConnectionStations(route);
    return cleaned;
  }

  public final function RemoveConnectionStations(route: array<RoutePoint>) -> array<RoutePoint> {
    let result: array<RoutePoint>;
    let indexesToSkip: array<Int32>;
    let i: Int32 = 0;
    let count: Int32 = route.Size();

    while (i < count) {
      if ((route[i].type == RoutePointType.LINE_SWITCH)) {
        indexesToSkip.PushBack(i - 1);
        indexesToSkip.PushBack(i + 1);
      }
      i += 1;
    }

    i = 0;
    while (i < count) {
      if (!indexesToSkip.Contains(i)) {
        result.PushBack(route[i]);
      }
      i += 1;
    }

    return result;
  }

  public final function BuildRouteDetails(path: array<MetroNode>) -> array<RoutePoint> {
    let tempRoute: array<RoutePoint>;
    let route: array<RoutePoint>;
    if ((path.Size() == 0)) { return tempRoute; }
    let previousLine: ModNCartLine = ModNCartLine.NONE;
    let currentLine: ModNCartLine = ModNCartLine.NONE;
    let count: Int32 = path.Size();
    let i: Int32 = 0;
    let node: MetroNode;
    let point: RoutePoint;
    while (i < count) {
      node = path[i];
      previousLine = currentLine;
      currentLine = node.Line();
      if ((previousLine != ModNCartLine.NONE) && (previousLine != currentLine)) {
        tempRoute.PushBack(LineSwitch.Create(node.StationId(), previousLine, currentLine));
      }
      tempRoute.PushBack(StationPoint.Create(node.StationId(), node.Line(), (i == 0), (i == count - 1)));
      i += 1;
    }

    count = tempRoute.Size();
    i = 0;
    while (i < count) {
      point = tempRoute[i];
      point.SetIndex(i);

      if ((i == 0)) {
        point.UpdateStatus(RoutePointStatus.ACTIVE);
      }
      route.PushBack(point);
      i += 1;
    }

    return route;
  }

  public final function PrettifyPath(path: array<Int32>) -> array<MetroNode> {
    let result: array<MetroNode>;
    let node: MetroNode;
    let point: Int32;
    let entryIndex1: Int32 = 0;
    while ((entryIndex1 < path.Size())) {
      point = path[entryIndex1];

      node = this.GetNode(point);
      if ((node != NULL)) { result.PushBack(node); }

      entryIndex1 += 1;
    }

    return result;
  }

  public final function FindShortestPath(from: ENcartStations, to: ENcartStations) -> array<Int32> {
    let startingStationId: Int32 = MetroDataHelper.GetStationIdByName(from);
    let startingLines: array<ModNCartLine> = MetroDataHelper.GetStationLinesById(startingStationId);
    let destinationStationId: Int32 = MetroDataHelper.GetStationIdByName(to);
    let destinationLines: array<ModNCartLine> = MetroDataHelper.GetStationLinesById(destinationStationId);
    let best: array<Int32>;
    let candidate: array<Int32>;
    let start: MetroNode;
    let end: MetroNode;
    let destinationIndex: Int32;
    let startIndex: Int32 = 0;
    while (startIndex < startingLines.Size()) {
      start = this.FindNode(startingStationId, startingLines[startIndex]);
      destinationIndex = 0;
      while (destinationIndex < destinationLines.Size()) {
        end = this.FindNode(destinationStationId, destinationLines[destinationIndex]);
        if (start && end) {
          candidate = this.BFS(start.Index(), end.Index());
          if (candidate.Size() > 0 && (best.Size() == 0 || candidate.Size() < best.Size())) {
            best = candidate;
          }
        }
        destinationIndex += 1;
      }
      startIndex += 1;
    }
    return best;
  }

  private final function BFS(from: Int32, to: Int32) -> array<Int32> {
    let dest: array<Int32> = this.Solve(from);
    let path: array<Int32> = this.ReconstructPath(from, to, dest);
    return path;
  }

  private final function Solve(index: Int32) -> array<Int32> {
    let queue: MetroNodesQueue = new MetroNodesQueue;
    queue.Add(index);

    let visited: array<Bool>;
    let dest: array<Int32>;

    let i: Int32 = 0;
    while (i < this.n) {
      visited.PushBack(false);
      i += 1;
    }

    visited[index] = true;

    i = 0;
    while (i < this.n) {
      dest.PushBack(-1);
      i += 1;
    }

    let curr: Int32;
    let next: Int32;
    let node: MetroGraphNode;
    let neighbours: array<Int32>;
    let neighbourIndex: Int32;
    while (queue.IsNotEmpty()) {
      curr = queue.PopLeft();
      node = this.graph.Get(Cast<Uint64>(curr)) as MetroGraphNode;
      neighbours = node.GetNeighbours();
      neighbourIndex = 0;
      while (neighbourIndex < neighbours.Size()) {
        next = neighbours[neighbourIndex];
        if (!visited[next]) {
          queue.Add(next);
          visited[next] = true;
          dest[next] = curr;
        }

        neighbourIndex += 1;
      }
    }

    return dest;
  }

  private final function ReconstructPath(s: Int32, e: Int32, dest: array<Int32>) -> array<Int32> {
    let empty: array<Int32>;
    let path: array<Int32>;
    let cursor: Int32 = e;
    while (cursor != -1) {
      path.PushBack(cursor);
      cursor = dest[cursor];
    }

    let reversed: array<Int32> = this.ReverseArray(path);
    if ((reversed[0] == s)) {
      return reversed;
    }

    return empty;
  }

  private final function ReverseArray(source: array<Int32>) -> array<Int32> {
    let result: array<Int32>;
    let i: Int32 = source.Size() - 1;
    while (i >= 0) {
      result.PushBack(source[i]);
      i -= 1;
    }

    return result;
  }

