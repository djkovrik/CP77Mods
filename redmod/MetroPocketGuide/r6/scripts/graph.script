  private final function SaveNode(node: MetroNode) -> Void {
    let key: Uint64 = node.Key();
    this.stations.Insert(key, node);
  }

  private final function GetNode(uniqueIndex: Int32) -> MetroNode {
    let key: Uint64 = Cast<Uint64>(uniqueIndex);
    let station: MetroNode = this.stations.Get(key) as MetroNode;
    return station;
  }

  private final function FindNode(stationId: Int32, line: ModNCartLine) -> MetroNode {
    let values: array<weak<IScriptable>>;
    let node: MetroNode;
    let value: weak<IScriptable>;
    this.stations.GetValues(values);

    let entryIndex5: Int32 = 0;
    while ((entryIndex5 < values.Size())) {
      value = values[entryIndex5];

      node = value as MetroNode;
      if ((node != NULL)) {
        if ((node.StationId() == stationId) && (node.Line() == line)) {
          return node;
        }
      }

      entryIndex5 += 1;
    }

    return NULL;
  }
}

